<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Select a Course</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
            margin: 0;
            padding: 40px;
        }

        h1 {
            margin-bottom: 30px;
        }

        .course-btn {
            display: block;
            width: 80%; 
            margin: 20px auto;
            padding: 30px; 
            font-size: 24px;
            font-weight: bold;
            background-color: #4c78af;
            color: white;
            border: none;
            border-radius: 15px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

        .course-btn:hover {
            background-color: #4c78af;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <h1>Courses</h1>

    <button class="course-btn" onclick="goToLessons('Math')">Math</button>
    <button class="course-btn" onclick="goToLessons('English')">English</button>
    <button class="course-btn" onclick="goToLessons('Physics')">Physics</button>
    <button class="course-btn" onclick="goToLessons('Computer Science')">Computer Science</button>

    <script>
        function goToLessons(courseName) {
            // Redirect to lessons page with course name in URL
            window.location.href = `lessons.html?course=${encodeURIComponent(courseName)}`;
        }
    </script>
</body>
</html>
