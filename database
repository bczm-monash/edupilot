USE edupilot;

DROP TABLE IF EXISTS classmate;
DROP TABLE IF EXISTS classroom;
DROP TABLE IF EXISTS enrolment;
DROP TABLE IF EXISTS course;
DROP TABLE IF EXISTS lesson;
DROP TABLE IF EXISTS user;

CREATE TABLE user (
    user_id         INT(10) NOT NULL COMMENT 'user id',
    user_title      VARCHAR(3) NOT NULL COMMENT 'user title - Mr, Mrs, Ms',
    user_fname      VARCHAR(30) NOT NULL COMMENT 'user first name',
    user_lname      VARCHAR(30) NOT NULL COMMENT 'user last name',
    user_email      VARCHAR(30) NOT NULL COMMENT 'user email - unique for each user',
    user_password   VARCHAR(30) NOT NULL COMMENT 'user password',
    user_role       VARCHAR(7) NOT NULL COMMENT 'user role'
);

ALTER TABLE user ADD CONSTRAINT user_pk PRIMARY KEY (user_id);
ALTER TABLE user ADD CONSTRAINT uq_user_email UNIQUE (user_email);
ALTER TABLE user ADD CONSTRAINT chk_user_role CHECK (user_role IN (
    'Student',
    'Teacher'
));
ALTER TABLE user ADD CONSTRAINT chk_user_title CHECK (user_title IN (
    'Mr',
    'Mrs',
    'Ms'
));

CREATE TABLE lesson (
    lesson_id            INT(10) NOT NULL COMMENT 'lesson id',
    lesson_desc          VARCHAR(100) NOT NULL COMMENT 'lesson description',
    lesson_prereq        INT(10) COMMENT 'lesson prerequisite',
    user_id              INT(10) NOT NULL COMMENT 'lesson creator',
    lesson_date_created  DATETIME NOT NULL COMMENT 'lesson created date',
    lesson_modified      DATETIME NOT NULL COMMENT 'lesson last modified date'
);

ALTER TABLE lesson ADD CONSTRAINT lesson_pk PRIMARY KEY (lesson_id);
ALTER TABLE lesson ADD CONSTRAINT lesson_user_fk FOREIGN KEY (user_id) REFERENCES user(user_id);
ALTER TABLE lesson ADD CONSTRAINT lesson_prereq_fk FOREIGN KEY (lesson_prereq) REFERENCES lesson(lesson_id)

CREATE TABLE course (
    course_id              VARCHAR(10) NOT NULL COMMENT 'course id',
    user_id                INT(10) NOT NULL COMMENT 'course creator',
    lesson_id              INT(10) COMMENT 'lesson id',
    course_desc            VARCHAR(100) NOT NULL COMMENT 'course desciption',
    course_date_created    DATETIME NOT NULL COMMENT 'course created date',
    course_modified        DATETIME NOT NULL COMMENT 'course last modified date',
    course_credit_points   INT(3) NOT NULL COMMENT 'course credit points'
);

ALTER TABLE course ADD CONSTRAINT course_pk PRIMARY KEY (course_id);
ALTER TABLE course ADD CONSTRAINT course_user_fk FOREIGN KEY (user_id) REFERENCES user(user_id);
ALTER TABLE course ADD CONSTRAINT course_lesson_fk FOREIGN KEY (lesson_id) REFERENCES lesson(lesson_id);

CREATE TABLE enrolment(
    user_id             INT(10) COMMENT 'user that enrolled into course',
    course_id           VARCHAR(10) COMMENT 'course id'
);

ALTER TABLE enrolment ADD CONSTRAINT enrolment_pk PRIMARY KEY (user_id,course_id);
ALTER TABLE enrolment ADD CONSTRAINT enrolment_user_fk FOREIGN KEY (user_id) REFERENCES user(user_id);
ALTER TABLE enrolment ADD CONSTRAINT enrolment_course_fk FOREIGN KEY (course_id) REFERENCES course(course_id);

CREATE TABLE classroom(
    classroom_id            INT(10) COMMENT 'classroom id',
    user_id                 INT(10) COMMENT 'creator id (teacher)',
    classroom_duration      DATETIME COMMENT 'classroom duration'  
);

ALTER TABLE classroom ADD CONSTRAINT classroom_pk PRIMARY KEY (classroom_id);
ALTER TABLE classroom ADD CONSTRAINT classroom_user_fk FOREIGN KEY (user_id) REFERENCES user(user_id);

CREATE TABLE classmate (
    user_id         INT(10) COMMENT 'class students id',
    classroom_id    INT(10) COMMENT 'classroom to join'
);

ALTER TABLE classmate ADD CONSTRAINT classmate_pk PRIMARY KEY (user_id,classroom_id);
ALTER TABLE classmate ADD CONSTRAINT classmate_user_fk FOREIGN KEY (user_id) REFERENCES user(user_id);
ALTER TABLE classmate ADD CONSTRAINT classmate_classroom_fk FOREIGN KEY (classroom_id) REFERENCES classroom(classroom_id);
COMMIT;
