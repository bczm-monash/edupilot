<!DOCTYPE html> <!--lesson creating page-->
<html lang="en">
<head> 
    <meta charset="utf-8">
    <style> 
        body { font-family: Arial, Helvetica, sans-serif; margin: 20px; }
        h2 { border-bottom: 2px solid #ccc; padding-bottom: 5px; }
        .lesson-list { margin-bottom: 20px; }
        .lesson { background: #f9f9f9; padding: 10px; margin-bottom: 5px; }
        label { display: block; margin-top: 10px; }
        input, select { width: 100%; padding: 5px; margin-top: 3px; }
        button { margin-top: 10px; padding: 8px 12px; }
    </style>
</head>
<body>
    <h1>Teachers Creating Page</h1>
    <h2>Create Lesson</h2>
    <form id="lessonForm">
        <label>Lesson ID:
            <input type="text" id="lessonID" required>
        </label>
        <label>Lesson Title:
            <input type="text" id="lessonTitle" required>
        </label>
        <label>Estimated Hours:
            <input type="text" id="estimatedHours" required>
        </label>
        <label>Prerequisites:
            <input type="text" id="prerequisite" placeholder="None">
        </label>
        <label>Credit Points:
            <input type="text" id="creditPoints" required>
        </label>
        <label>Assign to:
            <select id="assignmentStatus"> 
                <option value="fit2101">FIT2101</option>
                <option value="fit2014">FIT2014</option>
                <option value="unassigned">Unassigned Lessons</option>
            </select>
        </label>
        <button type="submit">Add Lesson</button>
    </form>

    <div class="lesson-list">
        <h2>FIT2101</h2>
        <div id="fit2101Lessons"></div>
    </div>

    <div class="lesson-list">
        <h2>FIT2014</h2>
        <div id="fit2014Lessons"></div>
    </div>

    <div class="lesson-list">
        <h2>Unassigned Lessons</h2>
        <div id="unassignedLessons"></div>
    </div>

    <script>
    document.getElementById("lessonForm").addEventListener("submit", function(event) {
        event.preventDefault();

        // Get form values
        const id = document.getElementById("lessonID").value;
        const title = document.getElementById("lessonTitle").value;
        const hours = document.getElementById("estimatedHours").value;
        const prerequisite = document.getElementById("prerequisite").value || "None";
        const credit = document.getElementById("creditPoints").value;
        const status = document.getElementById("assignmentStatus").value;

        // Create lesson element
        const lessonDiv = document.createElement("div");
        lessonDiv.classList.add("lesson");
        lessonDiv.innerHTML = `
            <strong>ID:</strong> ${id}<br>
            <strong>Title:</strong> ${title}<br>
            <strong>Estimated Hours:</strong> ${hours}<br>
            <strong>Prerequisite:</strong> ${prerequisite}<br>
            <strong>Credit Points:</strong> ${credit}<br>
        `;

        // Append lesson to correct section
        if (status === "fit2101") {
            document.getElementById("fit2101Lessons").appendChild(lessonDiv);
        } else if (status === "fit2014") {
            document.getElementById("fit2014Lessons").appendChild(lessonDiv);
        } else {
            document.getElementById("unassignedLessons").appendChild(lessonDiv);
        }

        // Reset form
        document.getElementById("lessonForm").reset();
    });
    </script>
</body>
</html>
